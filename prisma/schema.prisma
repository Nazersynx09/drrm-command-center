generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////////////////////////////////
// ENUMS
//////////////////////////////////////////////////////////

enum AlertLevel {
  WHITE
  BLUE
  RED
}

enum IncidentStatus {
  ACTIVE
  MONITORING
  CLOSED
  ARCHIVED
}

enum HazardType {
  TROPICAL_CYCLONE
  FLOOD
  EARTHQUAKE
  LANDSLIDE
  STORM_SURGE
  FIRE
  VOLCANIC_ACTIVITY
  OIL_SPILL
  MARINE_WILDLIFE
  OTHER
}

enum SubmissionStatus {
  DRAFT
  PENDING_VALIDATION
  VALIDATED
  UPDATED
  RETURNED
}

enum SubmissionSource {
  LGU_DIRECT
  PDRRMO_ASSISTED
  OFFLINE_SYNC
}

enum SyncStatus {
  SYNCED
  QUEUED
  FAILED
  CONFLICT
}

enum AttachmentEntity {
  INCIDENT
  SITREP
  STATE_OF_CALAMITY
  CASUALTY
  ROAD_BRIDGE
  TRANSPORTATION
  AGRICULTURE
  INFRASTRUCTURE
  OTHER
}

enum Sex {
  MALE
  FEMALE
}

enum ValidationStatus {
  YES
  NO
}

enum TransportationType {
  SEAPORT
  AIRPORT
}

enum HeaderStyle {
  CLASSIC
  MODERN
  COMPACT
}

enum HeaderAlignment {
  LEFT
  CENTER
}

enum UserRole {
  PROVINCIAL_ADMIN
  PDRRMO_ADMIN
  LGU_MDRRMO
  VIEWER
}

//////////////////////////////////////////////////////////
// MASTER TABLES
//////////////////////////////////////////////////////////

model Province {
  id       String @id @default(cuid())
  code     String @unique
  psgcCode String @unique
  name     String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  municipalities Municipality[]
}

model Municipality {
  id         String @id @default(cuid())
  provinceId String

  code     String @unique
  psgcCode String @unique
  name     String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  // LGU Branding
  mdrrmoHeadName     String?
  mdrrmoHeadPosition String? @default("Municipal Disaster Risk Reduction and Management Officer")

  preparedByName     String?
  preparedByPosition String? @default("Emergency Operations Center Officer")

  province Province @relation(fields: [provinceId], references: [id], onDelete: Cascade)

  barangays     Barangay[]
  users         User[]
  sitreps       Sitrep[]
  operationLogs OperationLog[]

  @@index([provinceId])
}

model Barangay {
  id String @id @default(cuid())

  municipalityId String

  code     String @unique
  psgcCode String @unique
  name     String

  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)

  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  relatedIncidents       RelatedIncident[]
  affectedPopulation     AffectedPopulation[]
  roads                  RoadBridge[]
  transportationStatuses TransportationStatus[]
  powers                 PowerStatus[]
  damagedHouses          DamagedHouse[]
  preemptiveEvacuations  PreemptiveEvacuation[]

  @@index([municipalityId])
}

//////////////////////////////////////////////////////////
// USERS
//////////////////////////////////////////////////////////

model User {
  id String @id @default(cuid())

  // Authentication
  name     String
  email    String @unique
  password String

  role UserRole

  isActive Boolean @default(true)

  // LGU assignment
  municipalityId String?
  municipality   Municipality? @relation(fields: [municipalityId], references: [id])

  // SITREP relationships
  submittedSitreps Sitrep[] @relation("SubmittedBy")
  encodedSitreps   Sitrep[] @relation("EncodedBy")
  validatedSitreps Sitrep[] @relation("ValidatedBy")

  // Audit trail
  snapshots     SitrepSnapshot[]
  operationLogs OperationLog[]

  // Files
  attachments Attachment[]

  // Metadata
  lastLogin DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

//////////////////////////////////////////////////////////
// INCIDENT
//////////////////////////////////////////////////////////

model Incident {
  id String @id @default(cuid())

  incidentCode String @unique
  name         String

  hazardType  HazardType
  description String?

  alertLevel AlertLevel     @default(WHITE)
  status     IncidentStatus @default(MONITORING)

  startDate DateTime
  endDate   DateTime?

  coverImageUrl      String?
  coverImagePublicId String?

  isActive Boolean @default(false)

  sitreps       Sitrep[]
  attachments   Attachment[]
  operationLogs OperationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  provincialNarrative ProvincialNarrative?

  @@index([status])
  @@index([isActive])
}

//////////////////////////////////////////////////////////
// LIVING SITREP
//////////////////////////////////////////////////////////

model Sitrep {
  id String @id @default(cuid())

  incidentId     String
  municipalityId String

  sitrepNumber  Int
  reportingDate DateTime @default(now())

  alertLevel        AlertLevel @default(WHITE)
  situationOverview String?    @db.Text
  actionsTaken      String?    @db.Text

  isLatest Boolean @default(true)

  deviceDraftId String?

  reportedByName     String?
  reportedByPosition String?

  submittedById String?
  encodedById   String?
  validatedById String?

  submissionSource SubmissionSource @default(LGU_DIRECT)
  syncStatus       SyncStatus       @default(SYNCED)

  assistedRemarks String?

  lastSyncedAt DateTime?

  serverVersion Int @default(1)

  incident     Incident     @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Cascade)

  submittedBy User? @relation("SubmittedBy", fields: [submittedById], references: [id])

  encodedBy User? @relation("EncodedBy", fields: [encodedById], references: [id])

  validatedBy User? @relation("ValidatedBy", fields: [validatedById], references: [id])

  submissions SitrepSubmission[]
  snapshots   SitrepSnapshot[]

  relatedIncidents       RelatedIncident[]
  affectedPopulation     AffectedPopulation[]
  casualties             Casualty[]
  roads                  RoadBridge[]
  transportationStatuses TransportationStatus[]
  powers                 PowerStatus[]
  damagedHouses          DamagedHouse[]
  agriculture            AgricultureDamage[]
  infrastructures        InfrastructureDamage[]
  classSuspension        ClassSuspension?
  workSuspension         WorkSuspension?
  stateOfCalamity        StateOfCalamity?
  preemptiveEvacuation   PreemptiveEvacuation?
  resourceCapabilities   ResourceCapability[]
  assistance             AssistanceProvided[]

  attachments   Attachment[]
  operationLogs OperationLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  isLocked Boolean @default(false)

  lockedByRole   UserRole?
  lockedByUserId String?
  lockedByName   String?
  lockedAt       DateTime?

  @@unique([incidentId, municipalityId, sitrepNumber])
  @@index([isLocked])
  @@index([incidentId])
  @@index([municipalityId])
  @@index([isLatest])
}

//////////////////////////////////////////////////////////
// SUBMISSION WORKFLOW
//////////////////////////////////////////////////////////

model SitrepSubmission {
  id String @id @default(cuid())

  sitrepId String

  submittedBy String?

  status SubmissionStatus @default(DRAFT)

  submissionSource SubmissionSource @default(LGU_DIRECT)
  syncStatus       SyncStatus       @default(SYNCED)

  submittedAt DateTime  @default(now())
  validatedAt DateTime?
  returnedAt  DateTime?

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SNAPSHOT HISTORY
//////////////////////////////////////////////////////////

model SitrepSnapshot {
  id String @id @default(cuid())

  sitrepId String
  version  Int

  snapshot Json

  createdById String?

  createdBy User? @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  @@unique([sitrepId, version])
}

//////////////////////////////////////////////////////////
// OPERATION LOG
//////////////////////////////////////////////////////////

model OperationLog {
  id String @id @default(cuid())

  incidentId     String?
  sitrepId       String?
  municipalityId String?
  userId         String?

  action      String
  description String?

  createdAt DateTime @default(now())

  incident     Incident?     @relation(fields: [incidentId], references: [id])
  sitrep       Sitrep?       @relation(fields: [sitrepId], references: [id])
  municipality Municipality? @relation(fields: [municipalityId], references: [id])
  user         User?         @relation(fields: [userId], references: [id])
}

//////////////////////////////////////////////////////////
// SECTION 1
//////////////////////////////////////////////////////////

model RelatedIncident {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String

  incidentDate  DateTime
  incidentType  String
  totalIncident Int

  description  String
  actionsTaken String?
  remarks      String?
  status       String?

  sitrep   Sitrep   @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay @relation(fields: [barangayId], references: [id])

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 2
//////////////////////////////////////////////////////////

model AffectedPopulation {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String

  families Int
  persons  Int

  evacuationCenters Int

  familiesInside Int
  personsInside  Int

  familiesOutside Int
  personsOutside  Int

  servedFamiliesInside Int
  servedPersonsInside  Int

  servedFamiliesOutside Int
  servedPersonsOutside  Int

  sitrep   Sitrep   @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay @relation(fields: [barangayId], references: [id])

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 3
//////////////////////////////////////////////////////////

model Casualty {
  id String @id @default(cuid())

  sitrepId String

  surname    String
  firstName  String
  middleName String?

  age Int
  sex Sex

  address String

  cause        String
  remarks      String?
  sourceOfData String

  validated ValidationStatus

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 4
//////////////////////////////////////////////////////////

model RoadBridge {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String

  type           String
  classification String
  section        String
  status         String

  reportedDate DateTime
  resumedDate  DateTime?

  remarks String?

  sitrep   Sitrep   @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay @relation(fields: [barangayId], references: [id])

  attachments Attachment[]

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 5
//////////////////////////////////////////////////////////

model TransportationStatus {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String?

  type TransportationType

  facilityName String
  status       String

  reportedDate DateTime
  resumedDate  DateTime?

  remarks String?

  sitrep   Sitrep    @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay? @relation(fields: [barangayId], references: [id])

  attachments Attachment[]

  @@index([sitrepId])
  @@index([barangayId])
}

//////////////////////////////////////////////////////////
// SECTION 6
//////////////////////////////////////////////////////////

model PowerStatus {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String

  distributor String

  interrupted Boolean
  restored    Boolean

  sitrep   Sitrep   @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay @relation(fields: [barangayId], references: [id])

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 7
//////////////////////////////////////////////////////////

model DamagedHouse {
  id String @id @default(cuid())

  sitrepId   String
  barangayId String

  partial Int
  total   Int

  totalDamaged Int
  amount       Decimal @db.Decimal(18, 2)

  remarks String?

  sitrep   Sitrep   @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay @relation(fields: [barangayId], references: [id])

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 8
//////////////////////////////////////////////////////////

model AgricultureDamage {
  id String @id @default(cuid())

  sitrepId String

  classification String
  cropType       String

  affectedFarmers Int

  totallyDamaged   Decimal @db.Decimal(12, 2)
  partiallyDamaged Decimal @db.Decimal(12, 2)

  totalDamaged Decimal @db.Decimal(12, 2)

  productionLoss Decimal @db.Decimal(18, 2)
  damageCost     Decimal @db.Decimal(18, 2)

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 9
//////////////////////////////////////////////////////////

model InfrastructureDamage {
  id String @id @default(cuid())

  sitrepId String

  infrastructureType String
  classification     String

  name String

  damagedCount Int
  unit         String

  damagedQuantity Decimal @db.Decimal(12, 2)

  status String

  damageCost Decimal @db.Decimal(18, 2)

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  attachments Attachment[]

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 10
//////////////////////////////////////////////////////////

model ClassSuspension {
  id String @id @default(cuid())

  sitrepId String @unique

  levelFrom String
  levelTo   String

  levelType String

  suspendedAt DateTime
  resumedAt   DateTime?

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// SECTION 11
//////////////////////////////////////////////////////////

model WorkSuspension {
  id String @id @default(cuid())

  sitrepId String @unique

  suspensionType String

  suspendedAt DateTime
  resumedAt   DateTime?

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
}

//////////////////////////////////////////////////////////
// SECTION 12
//////////////////////////////////////////////////////////

model StateOfCalamity {
  id String @id @default(cuid())

  sitrepId String @unique

  resolutionNumber String
  resolutionDate   DateTime

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  attachments Attachment[]
}

//////////////////////////////////////////////////////////
// SECTION 13
//////////////////////////////////////////////////////////

model PreemptiveEvacuation {
  id String @id @default(cuid())

  sitrepId   String  @unique
  barangayId String?

  barangays Int

  families Int

  male   Int
  female Int

  totalFamilies Int

  remarks String?

  sitrep   Sitrep    @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  barangay Barangay? @relation(fields: [barangayId], references: [id])
}

//////////////////////////////////////////////////////////
// SECTION 14
//////////////////////////////////////////////////////////

model AssistanceProvided {
  id String @id @default(cuid())

  sitrepId String

  affectedFamilies Int

  needs String

  requiringAssistance Int

  quantity Decimal @db.Decimal(18, 2)

  unit String

  costPerUnit Decimal @db.Decimal(18, 2)

  source String

  assistedFamilies Int

  assistedPercentage Decimal @db.Decimal(5, 2)

  remarks String?

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// SECTION 15
//////////////////////////////////////////////////////////

model LGUProfile {
  id String @id @default(cuid())

  municipalityCode String @unique

  municipalityName String
  province         String @default("Province of Iloilo")

  officeName String
  address    String

  telephone String?
  mobile    String?
  email     String?
  website   String?

  municipalLogo       String?
  mdrrmoLogo          String?
  bagongPilipinasLogo String?

  mdrrmoHead         String?
  mdrrmoHeadPosition String?

  preparedBy         String?
  preparedByPosition String?

  headerStyle HeaderStyle @default(CLASSIC)

  logoSize Int @default(80)
  logoGap  Int @default(24)

  textAlign HeaderAlignment @default(CENTER)

  topBanner Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// SECTION 15-a
//////////////////////////////////////////////////////////

model ProvinceProfile {
  id String @id @default(cuid())

  provinceCode String @unique @default("ILOILO")

  provinceName String @default("Province of Iloilo")

  officeName String @default("Provincial Disaster Risk Reduction and Management Office")

  address String @default("Casa Real de Iloilo, Iloilo City")

  telephone String?
  mobile    String?
  email     String?
  website   String?

  provincialSeal      String?
  pdrrmoLogo          String?
  bagongPilipinasLogo String?

  governorName     String?
  governorPosition String  @default("Governor")

  pdrrmoHeadName     String?
  pdrrmoHeadPosition String  @default("PDRRMO Head")

  preparedByName     String?
  preparedByPosition String  @default("Emergency Operations Center")

  verifiedByName     String?
  verifiedByPosition String?

  headerStyle HeaderStyle @default(MODERN)

  textAlign HeaderAlignment @default(CENTER)

  topBanner Boolean @default(true)

  logoSize Int @default(90)
  logoGap  Int @default(24)

  provinceFontSize Int @default(16)
  officeFontSize   Int @default(34)
  addressFontSize  Int @default(15)
  contactFontSize  Int @default(13)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// SECTION 16
//////////////////////////////////////////////////////////

model ResourceCapability {
  id String @id @default(cuid())

  sitrepId String

  category String @default("Personnel")
  resource String

  available Int @default(0)
  deployed  Int @default(0)
  remaining Int @default(0)

  sortOrder Int @default(0)

  sitrep Sitrep @relation(fields: [sitrepId], references: [id], onDelete: Cascade)

  @@unique([sitrepId, resource])
  @@index([sitrepId])
}

//////////////////////////////////////////////////////////
// PROVINCIAL NARRATIVES
//////////////////////////////////////////////////////////

model ProvincialNarrative {
  id String @id @default(cuid())

  incidentId String   @unique
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)

  situationOverview String? @db.Text
  actionsTaken      String? @db.Text

  updatedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//////////////////////////////////////////////////////////
// UNIVERSAL ATTACHMENTS (Cloudinary Metadata Only)
//////////////////////////////////////////////////////////

model Attachment {
  id String @id @default(cuid())

  entityType AttachmentEntity

  fileName String
  fileUrl  String
  publicId String

  mimeType String
  fileSize Int

  uploadedById String?

  uploadedBy User? @relation(fields: [uploadedById], references: [id])

  incidentId             String?
  sitrepId               String?
  casualtyId             String?
  roadBridgeId           String?
  transportationStatusId String?
  agricultureDamageId    String?
  infrastructureDamageId String?
  stateOfCalamityId      String?

  incident             Incident?             @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  sitrep               Sitrep?               @relation(fields: [sitrepId], references: [id], onDelete: Cascade)
  casualty             Casualty?             @relation(fields: [casualtyId], references: [id], onDelete: Cascade)
  roadBridge           RoadBridge?           @relation(fields: [roadBridgeId], references: [id], onDelete: Cascade)
  transportationStatus TransportationStatus? @relation(fields: [transportationStatusId], references: [id], onDelete: Cascade)
  agricultureDamage    AgricultureDamage?    @relation(fields: [agricultureDamageId], references: [id], onDelete: Cascade)
  infrastructureDamage InfrastructureDamage? @relation(fields: [infrastructureDamageId], references: [id], onDelete: Cascade)
  stateOfCalamity      StateOfCalamity?      @relation(fields: [stateOfCalamityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([incidentId])
  @@index([sitrepId])
  @@index([casualtyId])
  @@index([roadBridgeId])
  @@index([transportationStatusId])
  @@index([agricultureDamageId])
  @@index([infrastructureDamageId])
  @@index([stateOfCalamityId])
}
