# PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# PAGASA Ten-day Forecast API (optional, requires a formal request to PAGASA).
# Without it the dashboard uses free Open-Meteo (weather), USGS (earthquakes) and GDACS (disasters).
PAGASA_API_TOKEN="YOUR_PAGASA_TOKEN"
PAGASA_PROVINCE="Iloilo"

# Optional: coordinates used for the forecast and earthquake radius (defaults to Iloilo City)
# FORECAST_LAT=10.7202
# FORECAST_LON=122.5621
